# ─── 服务器 ───────────────────────────────────────
PORT=9000
ENVIRONMENT=development    # development（开发） | staging（预发布） | production（生产）
BASE_URL=http://localhost:9000

# ─── 数据库 ─────────────────────────────────────
DATABASE_URL=postgres://keygate:keygate@localhost:5432/keygate?sslmode=disable

# ─── 安全（必填，使用以下命令生成：openssl rand -hex 32） ───
JWT_SECRET=
LICENSE_SIGNING_KEY=

# ─── 支付（Stripe） ──────────────────────────
# Stripe：https://dashboard.stripe.com/apikeys
# 仅需 STRIPE_SECRET_KEY。Webhook 会自动配置。
STRIPE_SECRET_KEY=

# ─── 邮件（可选，如果未设置，OTP 验证码将打印到日志中） ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Redis（可选，用于分布式限流） ───
REDIS_URL=

# ─── 限流（每分钟请求数） ───────────
RATE_LIMIT_API=60
RATE_LIMIT_ADMIN=120
# 每个 IP 每分钟的登录/OTP 验证预算。同一 NAT 后面的办公室共享该预算。
RATE_LIMIT_AUTH=60
# 每个 IP 每小时的登录验证码发送次数。故意设置得很严格：此端点会向
# 调用者提供的地址发送邮件，因此宽松的预算会让某人利用
# 你的服务器（以及你的发送信誉）向第三方发送垃圾邮件。
RATE_LIMIT_OTP_SEND=30

# ─── Webhooks ────────────────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INTERVAL=30s
WEBHOOK_HTTP_TIMEOUT=10s
# 允许 webhook 投递到回环/私有/本地链路地址
# （例如同一 Docker 网络上的接收方）。默认关闭。
# 当出站流量经过 HTTP_PROXY 且只有代理可以解析 DNS 时也需要此设置：
# 服务器通过自行解析目标来对代理目标进行分类，并拒绝无法解析的名称。
WEBHOOK_ALLOW_PRIVATE=false

# ─── 配额 ──────────────────────────────────────
QUOTA_WARNING_THRESHOLD=0.8

# ─── 管理员引导 ─────────────────────────────
# 逗号分隔的邮箱列表，首次登录时自动提升为管理员。
ADMIN_EMAILS=

# 对象存储（发布版本）
# 公共更新源（Sparkle/Velopack/Tauri）中构建产物 URL 的有效期。
# 用户可能在获取更新源很久之后才点击安装。
STORAGE_FEED_URL_TTL=24h